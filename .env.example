# =============================================================
# TicketEase — Environment Variables
# =============================================================

# Database
DATABASE_URL=postgresql://ticketease:ticketease@localhost:5432/ticketease?schema=public

# Server Port & URLs
PORT=8080
SERVER_PORT=8080
NODE_ENV=development
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=ticketease-super-secret-key-development-min-256-bits-xyz
JWT_EXPIRATION=7d
JWT_REFRESH_EXPIRATION=30d

# QR Code Ticket Validation Secret
QR_SECRET=ticketease-qr-signature-secret-key-32bytes

# Mail / SMTP (Optional - logs to console if false)
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@ticketease.demo

# Business Rules
SEAT_HOLD_MINUTES=5
WAITLIST_OFFER_MINUTES=5
CANCELLATION_CUTOFF_HOURS=0.5
